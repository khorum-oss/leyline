{
  "name": "@leyline/core",
  "version": "0.0.0",
  "description": "Headless Leyline runtime: interpreter, store, capability binding, control plane, trace stream",
  "license": "Apache-2.0",
  "author": "Leyline contributors",
  "homepage": "https://github.com/khorum-oss/leyline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khorum-oss/leyline.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/khorum-oss/leyline/issues"
  },
  "keywords": [
    "leyline",
    "workflow",
    "statechart",
    "headless",
    "control-plane"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@leyline/schema": "workspace:^",
    "xstate": "^5.24.0"
  }
}
