{
  "name": "@leyline/svelte",
  "version": "0.0.0",
  "description": "Svelte store bridge and component for Leyline",
  "license": "Apache-2.0",
  "author": "Leyline contributors",
  "homepage": "https://github.com/khorum-oss/leyline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khorum-oss/leyline.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/khorum-oss/leyline/issues"
  },
  "keywords": [
    "leyline",
    "svelte",
    "adapter"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package --input src/lib --output dist --tsconfig tsconfig.package.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@leyline/core": "workspace:^",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@leyline/agent": "workspace:^",
    "@leyline/core": "workspace:^",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.42.2"
  },
  "svelte": "./dist/index.js"
}
