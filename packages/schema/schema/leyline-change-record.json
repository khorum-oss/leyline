{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leyline.dev/schema/1.0.0/leyline-change-record.json",
  "title": "Leyline change record",
  "x-leyline-version": "1.0.0",
  "$ref": "#/$defs/LeylineChangeRecord",
  "$defs": {
    "LeylineChangeRecord": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "proposalId": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "change": {
          "$ref": "#/$defs/LeylineChange"
        },
        "initiator": {
          "$ref": "#/$defs/LeylineInitiator"
        },
        "appliedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revertedBy": {
          "$ref": "#/$defs/LeylineIdentifier"
        }
      },
      "required": [
        "id",
        "proposalId",
        "change",
        "initiator",
        "appliedAt"
      ],
      "additionalProperties": false,
      "title": "Change record"
    },
    "LeylineIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Identifier",
      "description": "An opaque, stable identifier. Author-supplied names or system-derived content hashes; never a path, URL, or expression."
    },
    "LeylineChange": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "renderer.register"
            },
            "registry": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "renderer": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "match": {
              "$ref": "#/$defs/LeylineRendererMatch"
            },
            "rank": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "kind",
            "registry",
            "renderer",
            "match",
            "rank"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "renderer.unregister"
            },
            "registry": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "entry": {
              "$ref": "#/$defs/LeylineIdentifier"
            }
          },
          "required": [
            "kind",
            "registry",
            "entry"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "surface.attach-guard"
            },
            "node": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "surface": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "guard": {
              "$ref": "#/$defs/LeylineCapabilityName"
            }
          },
          "required": [
            "kind",
            "node",
            "surface",
            "guard"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "surface.detach-guard"
            },
            "node": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "surface": {
              "$ref": "#/$defs/LeylineIdentifier"
            }
          },
          "required": [
            "kind",
            "node",
            "surface"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "section.reorder-children"
            },
            "node": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "children": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/LeylineIdentifier"
              }
            }
          },
          "required": [
            "kind",
            "node",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "section.move-child"
            },
            "child": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "from": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "to": {
              "$ref": "#/$defs/LeylineIdentifier"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "child",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workflow.replace"
            },
            "document": {
              "$ref": "#/$defs/LeylineWorkflowDocument"
            }
          },
          "required": [
            "kind",
            "document"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "context.patch"
            },
            "values": {
              "$ref": "#/$defs/LeylineProps"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "additionalProperties": false
        }
      ],
      "title": "Change",
      "description": "A proposed mutation of a registry or a workflow, as pure data."
    },
    "LeylineRendererMatch": {
      "type": "object",
      "properties": {
        "surfaceId": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "surfaceType": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "$ref": "#/$defs/LeylineIdentifier"
        }
      },
      "additionalProperties": false,
      "title": "Renderer match"
    },
    "LeylineCapabilityName": {
      "title": "Capability name",
      "description": "The name of a guard, service, or data source. Implementations bind separately through a capability bundle; a document can never carry one.",
      "$ref": "#/$defs/LeylineIdentifier"
    },
    "LeylineWorkflowDocument": {
      "type": "object",
      "properties": {
        "leylineVersion": {
          "type": "string",
          "pattern": "^(1)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "id": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "entry": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "context": {
          "$ref": "#/$defs/LeylineContextShape"
        },
        "requires": {
          "$ref": "#/$defs/LeylineRequirements"
        },
        "nodes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeylineNode"
          }
        }
      },
      "required": [
        "leylineVersion",
        "id",
        "name",
        "entry",
        "nodes"
      ],
      "additionalProperties": {},
      "title": "Leyline workflow document",
      "description": "The canonical, serializable description of a workflow: sequencing, eligibility, navigation, and semantic UI intent."
    },
    "LeylineContextShape": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/LeylineIdentifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/LeylineContextField"
      },
      "title": "Context shape",
      "description": "The typed data a workflow instance carries, keyed by field name."
    },
    "LeylineContextField": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "unknown"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "title": "Context field"
    },
    "LeylineRequirements": {
      "type": "object",
      "properties": {
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeylineCapabilityName"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeylineCapabilityName"
          }
        },
        "dataSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeylineCapabilityName"
          }
        }
      },
      "additionalProperties": {},
      "title": "Requirements block",
      "description": "Every capability name this document may reference. Binding verifies the set."
    },
    "LeylineNode": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeylineSurface"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeylineIdentifier"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "one",
            "many"
          ]
        },
        "initial": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "invoke": {
          "$ref": "#/$defs/LeylineInvoke"
        },
        "on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeylineEventTransition"
          }
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": {},
      "title": "Node",
      "description": "A position in the workflow graph, with the surfaces it presents."
    },
    "LeylineSurface": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/LeylineCapabilityName"
        },
        "dataSource": {
          "$ref": "#/$defs/LeylineCapabilityName"
        },
        "target": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "props": {
          "$ref": "#/$defs/LeylineProps"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {},
      "title": "Surface",
      "description": "Semantic UI intent attached to a node, resolved to a component by a registry."
    },
    "LeylineProps": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/LeylineIdentifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/LeylineJsonValue"
      },
      "title": "Renderer props"
    },
    "LeylineJsonValue": {
      "title": "JSON value",
      "description": "Arbitrary serializable data, treated as inert by every consumer (I4).",
      "$ref": "#/$defs/__schema0"
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "LeylineInvoke": {
      "type": "object",
      "properties": {
        "service": {
          "$ref": "#/$defs/LeylineCapabilityName"
        },
        "input": {
          "$ref": "#/$defs/LeylineProps"
        },
        "assignTo": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "onDone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeylineTransition"
          }
        },
        "onError": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeylineTransition"
          }
        }
      },
      "required": [
        "service"
      ],
      "additionalProperties": {},
      "title": "Service invocation"
    },
    "LeylineTransition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "target": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "when": {
          "$ref": "#/$defs/LeylineCapabilityName"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": {},
      "title": "Transition"
    },
    "LeylineEventTransition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "target": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "when": {
          "$ref": "#/$defs/LeylineCapabilityName"
        },
        "description": {
          "type": "string"
        },
        "on": {
          "$ref": "#/$defs/LeylineEventName"
        }
      },
      "required": [
        "target",
        "on"
      ],
      "additionalProperties": {},
      "title": "Event transition"
    },
    "LeylineEventName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$",
      "title": "Event name"
    },
    "LeylineInitiator": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "application",
            "developer",
            "agent",
            "user"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "title": "Initiator"
    }
  }
}
