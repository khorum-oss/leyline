{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leyline.dev/schema/1.0.0/leyline-trace-event.json",
  "title": "Leyline trace event",
  "x-leyline-version": "1.0.0",
  "$ref": "#/$defs/LeylineTraceEvent",
  "$defs": {
    "LeylineTraceEvent": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "$ref": "#/$defs/LeylineIdentifier"
        },
        "initiator": {
          "$ref": "#/$defs/LeylineInitiator"
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "ts",
        "seq",
        "kind",
        "correlationId",
        "initiator",
        "data"
      ],
      "additionalProperties": false,
      "title": "Trace event",
      "description": "One message on the core’s single ordered observability stream."
    },
    "LeylineIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Identifier",
      "description": "An opaque, stable identifier. Author-supplied names or system-derived content hashes; never a path, URL, or expression."
    },
    "LeylineInitiator": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "application",
            "developer",
            "agent",
            "user"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "attested": {
          "$ref": "#/$defs/LeylineAttestation"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "title": "Initiator"
    },
    "LeylineAttestation": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "via": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "subject",
        "via"
      ],
      "additionalProperties": false,
      "title": "Transport attestation"
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
